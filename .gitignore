# Python virtualenv (182MB, recreate with: python3 -m venv .venv)
.venv/
__pycache__/
*.py[cod]

# Captured WLED effect loops -- regenerated on demand by backgrounds.py
.bg-loops/

# User media for the video/loop mode
videos/*
!videos/.gitkeep

# Learned Tron evaluator weights: this is per-install training state, not
# source. Deleting it just makes the AI relearn from scratch.
tron_brain.json

# macOS
.DS_Store

# HA notify shared-secret token -- a real credential, unlike every other
# *_config.json here (leagues/URLs/coordinates). Generated at runtime by
# notify.load_config() on first POST /api/notify; never committed.
notify_config.json

# Now Playing's Last.fm API key -- same real-credential category as
# notify_config.json above, once the owner sets one via the control
# panel. The tracked baseline (both fields null) is not committed
# either, to keep this file consistently gitignored regardless of state
# rather than committed-until-a-key-exists.
nowplaying_config.json

# ATC transcription log -- runtime state (real transcript text with real
# timestamps), not source, and personal-rig-only (see atc.py/CLAUDE.md).
atc_log.jsonl

# THE HANGAR -- persistent aircraft collection, real runtime state (real
# tail numbers with real timestamps), not source (see hangar.py).
hangar_log.jsonl

# Recent-events log -- same category as hangar_log.jsonl/atc_log.jsonl,
# real runtime state (real event summaries with real timestamps), not
# source (see events_log.py).
events_log.jsonl

# Storm Desk session strip + Home Hub house facts — runtime, not source.
storm_log.jsonl
home_log.jsonl

# Last-good CelesTrak / station TLE catalogue -- runtime cache so a
# dead visual host does not wipe the sky on restart (see skypass.py).
skypass_tle_cache.txt

.claude/worktrees/
